# ==========================================
# Bill Saathi AI Backend Configuration
# ==========================================

# Application Environment
PROJECT_NAME="Bill Saathi AI"
ENV="development"
DEBUG=true
DEMO_MODE=true

# Database (PostgreSQL / Supabase connection or SQLite fallback)
# For Supabase / Postgres: postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_HOST.supabase.co:5432/postgres
DATABASE_URL="sqlite:///./billsaathi.db"

# JWT Authentication
SECRET_KEY="replace-this-with-a-random-secret-key-at-least-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API (Optional in DEMO_MODE=true)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:8000"

# Storage Configuration
UPLOAD_DIR="./uploads"
REPORT_DIR="./reports"
MAX_UPLOAD_SIZE_MB=15
MAX_PDF_PAGES=20
